#import "/lib/zk.typ": *

= Lie algebra ideal
#tags("lie-theory")

#defn[
  An _ideal_ $frak(h)$ of lie algebra $frak(g)$ is subspace
  closed under the lie bracket with all elements of $frak(g)$.
  I.e., if $forall Y in frak(h)$ and $X in frak(g)$, $[X, Y] in frak(h)$.
]

#separator

#defn[
  A lie algebra is called _simple_ if it has no ideals other than itself and ${bold(0)}$.
]

#separator

#remark[
  The _ideal_ terminology comes from ring theory.
  A lie algebra is a ring in which lie bracket is the product operation.
]

#cite("stillwell2008")[§6.1]
