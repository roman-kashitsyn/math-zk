#import "/lib/zk.typ": *

= Universal construction
#tags("ct")

#defn[
  A _universal property_ defines an object
  through its relations to other objects in the category
  rather than through its internal structure.
]

#defn[
  A _universal construction_ defines a category
  formed by objects and arrows that share a property
  and identifies the "best" object having that property
  as the terminal object in the constructed category.
  That canonical object is said to have the _universal property_.
]
