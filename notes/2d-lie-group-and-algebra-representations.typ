#import "/lib/zk.typ": *

= Lie group and algebra representations
#tags("lie-theory")

#defn[
  Let $G$ be a matrix Lie group and $V$ be a finite-dimensional (complex or real) vector space ($"dim"(V) gt.eq 1$).
  A Lie group homomorphism $Pi : G -> "GL"(V)$
  is called a _finite-dimensional (complex or real) representation_ of $G$ acting on $V$.
]

#separator

#defn[
  Similarly, let $frak(g)$ be a Lie algebra and $V$ be a finite-dimensional complex/real vector space ($"dim"(V) gt.eq 1$).
  A Lie algebra homomorphism $pi : frak(g) -> frak("gl")(V)$
  is called a _finite-dimensional complex/real representation_ of $frak(g)$ acting on $V$.
]

#separator

#defn[
  If $Pi$/$pi$ is a one-to-one homomorphism,
  it's called _faithful_.
]

#cite("hall2003")[§4.1]
